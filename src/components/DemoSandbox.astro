---
/**
 * A sandboxed lookalike of the real GetYourWebsite client portal.
 *
 * Source of truth: GetYourWebsite-now/GetYourWebsiteAdmin, branch `development`,
 * the `client/` workspace. Specifically:
 *   client/src/layouts/Dashboard.jsx      the sidebar groups, topbar, tab set
 *   client/src/pages/ExploreTab.jsx       the dashboard: KPIs, quick actions,
 *                                         and how the recommendations are chosen
 *   client/src/pages/RealSiteTab.jsx      "My website" + the version list
 *   client/src/pages/VersionTreeTab.jsx   the lineage view
 *   client/src/pages/MockSiteTab.jsx      "Free preview"
 *   client/src/pages/AssetsTab.jsx        the image library
 *   client/src/components/ReviseSitePanel.jsx  the change-request workspace
 *   client/src/clientRevision.js          friendly labels + the prompt format
 *   client/src/index.css                  every token and class name below
 *
 * NOTE ON DIRECTORIES: the portal is `client/`, not `frontend/`. `frontend/` is
 * the staff admin app — leads, calls, users. Easy to get backwards, since the
 * client portal used to be the neglected one; it isn't any more.
 *
 * The layout, class names, copy and state names are copied from that app so
 * this is an honest preview rather than an impression of one. What is different
 * here, on purpose (kept in step with the list on /demo):
 *   - No backend, no auth, no network. All state is in memory (src/scripts/demo.js)
 *     and resets on reload or on "Reset demo".
 *   - The login and set-password screens are skipped; you arrive signed in.
 *   - Sending a change request shows the real success banner, but obviously
 *     doesn't email anyone.
 *   - Assets can't be uploaded; "Add images" drops in samples instead.
 *   - The version tree is a straight line — the real one branches.
 *
 * The portal used to be dark slate and mint. It was redesigned onto gold-on-
 * black, and its token block now says outright that it mirrors this marketing
 * site — so the palette below is our four colours under the portal's own names,
 * not a foreign theme being quarantined.
 */
---

<div class="sandbox" data-sandbox>
  <!-- Persistent banner, ours rather than the portal's -->
  <p class="sandbox__banner">
    <span class="sandbox__dot" aria-hidden="true"></span>
    Live demo with sample data — this is exactly what you get as a GetYourWebsite client.
    <button type="button" class="sandbox__reset" data-reset>Reset demo</button>
  </p>

  <div class="sandbox__frame">
    <!-- ── The portal ──────────────────────────────────────────────────── -->
    <div class="client-dashboard" data-portal>
      <!-- Sidebar. Three groups, same order and same hints as the real app. -->
      <aside class="client-sidebar" aria-label="Client portal">
        <div class="client-sidebar-brand">
          <span class="client-wordmark">
            <svg class="client-wordmark__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <circle cx="16" cy="16" r="7" fill="var(--gold)"></circle>
              <circle cx="12.5" cy="13" r="6" fill="var(--black)" opacity="0.35"></circle>
              <ellipse
                cx="16" cy="16" rx="14.2" ry="5.4"
                stroke="var(--gold)" stroke-width="1.6" opacity="0.75"
                transform="rotate(-28 16 16)"></ellipse>
            </svg>
            <span class="client-wordmark__text">GetYourWebsite</span>
          </span>
          <span class="client-tagline">Client portal</span>
        </div>

        <nav class="client-nav" aria-label="Portal sections">
          <div class="client-nav-group">
            <p class="client-nav-group-label">Home</p>
            <button type="button" class="client-nav-tab active" data-tab="explore">
              <span class="client-nav-tab__label">Explore</span>
              <span class="client-nav-tab__hint">Overview &amp; next steps</span>
            </button>
          </div>
          <div class="client-nav-group">
            <p class="client-nav-group-label">Website</p>
            <button type="button" class="client-nav-tab" data-tab="real-site">
              <span class="client-nav-tab__label">My website</span>
              <span class="client-nav-tab__hint">Live site &amp; versions</span>
            </button>
            <button type="button" class="client-nav-tab" data-tab="version-tree">
              <span class="client-nav-tab__label">Version tree</span>
              <span class="client-nav-tab__hint">Branching lineage</span>
            </button>
            <button type="button" class="client-nav-tab" data-tab="mock-site">
              <span class="client-nav-tab__label">Free preview</span>
              <span class="client-nav-tab__hint">Sample mockup</span>
            </button>
          </div>
          <div class="client-nav-group">
            <p class="client-nav-group-label">Library</p>
            <button type="button" class="client-nav-tab" data-tab="assets">
              <span class="client-nav-tab__label">Assets</span>
              <span class="client-nav-tab__hint">Photos &amp; files</span>
            </button>
          </div>
        </nav>

        <div class="client-sidebar-footer">
          <div class="client-user-chip client-user-chip--profile">
            <span class="client-user-avatar" aria-hidden="true">R</span>
            <span class="client-user-chip__text">
              <span class="client-user-chip__name">Rosa</span>
              <span class="client-user-chip__label">Client</span>
            </span>
          </div>
          <button type="button" class="client-btn-ghost" data-signout>Sign out</button>
        </div>
      </aside>

      <div class="client-content">
        <header class="client-topbar">
          <div class="client-topbar-left">
            <button type="button" class="client-burger" data-burger aria-expanded="false">
              <span class="sr-only">Open menu</span>
              <span class="client-burger-bar" aria-hidden="true"></span>
              <span class="client-burger-bar" aria-hidden="true"></span>
            </button>
            <nav class="client-breadcrumbs" aria-label="Breadcrumb">
              <span class="client-breadcrumbs__current" data-crumb>Explore</span>
            </nav>
          </div>
          <div class="client-topbar-right">
            <span class="client-topbar-user">Rosa</span>
            <button type="button" class="client-btn-ghost client-topbar-signout" data-signout>
              Sign out
            </button>
          </div>
        </header>

        <main class="client-main" data-main>
          <!-- Explore ------------------------------------------------------ -->
          <div class="portal-tab explore-tab" data-panel="explore">
            <header class="explore-welcome">
              <div>
                <p class="dash-eyebrow">Explore</p>
                <h1>Welcome back, Rosa</h1>
                <p class="portal-tab-lead" data-explore-summary></p>
              </div>
              <button type="button" class="client-btn-soft" data-check="explore">Refresh</button>
            </header>

            <section class="explore-kpi-grid" aria-label="Overview metrics">
              <article class="explore-kpi-card">
                <span class="dash-kpi-label">Website status</span>
                <strong class="dash-kpi-value tone-ok" data-kpi-status>Ready</strong>
                <span class="explore-kpi-trend" data-kpi-status-trend></span>
              </article>
              <article class="explore-kpi-card">
                <span class="dash-kpi-label">Approved versions</span>
                <strong class="dash-kpi-value" data-kpi-versions>3</strong>
                <span class="explore-kpi-trend" data-kpi-versions-trend></span>
              </article>
              <article class="explore-kpi-card">
                <span class="dash-kpi-label">Library images</span>
                <strong class="dash-kpi-value" data-kpi-assets>0</strong>
                <span class="explore-kpi-trend" data-kpi-assets-trend></span>
              </article>
            </section>

            <section class="explore-quick-grid" aria-label="Quick actions">
              <button type="button" class="explore-quick-card" data-open-site>
                <span class="explore-quick-card__icon" aria-hidden="true">⌘</span>
                <span class="explore-quick-card__title">Open website</span>
                <span class="explore-quick-card__detail">Launch the latest approved version</span>
              </button>
              <button type="button" class="explore-quick-card" data-open-mock>
                <span class="explore-quick-card__icon" aria-hidden="true">◇</span>
                <span class="explore-quick-card__title">Open preview</span>
                <span class="explore-quick-card__detail">View your free sample site</span>
              </button>
              <button type="button" class="explore-quick-card" data-tab="assets">
                <span class="explore-quick-card__icon" aria-hidden="true">+</span>
                <span class="explore-quick-card__title">Add images</span>
                <span class="explore-quick-card__detail">Upload photos to your asset library</span>
              </button>
            </section>

            <section class="explore-recommended" aria-label="Recommended actions">
              <div class="dash-resource-toolbar">
                <div>
                  <h2 class="dash-section-title">Recommended actions</h2>
                  <p class="dash-section-lead">
                    Next steps based on your website, preview, and library.
                  </p>
                </div>
              </div>
              <ul class="explore-recommended-list" data-recommended></ul>
            </section>
          </div>

          <!-- My website --------------------------------------------------- -->
          <div class="portal-tab real-site-tab" data-panel="real-site" hidden>
            <div class="portal-tab-header">
              <div>
                <p class="dash-eyebrow">Website</p>
                <h1>My website</h1>
                <p class="portal-tab-lead">
                  Open the latest approved version, or request changes to any version below.
                </p>
              </div>
              <button type="button" class="client-btn-soft" data-check="site">Check again</button>
            </div>

            <div class="portal-alert portal-alert-success" data-success hidden></div>

            <div class="portal-panel">
              <span class="portal-status">Ready</span>
              <h2>Rosa's Bakery</h2>
              <p class="portal-copy">
                Your website is approved. Open the latest version, or request changes to any
                approved version below.
              </p>
              <p class="portal-meta" data-latest-version>Version 3</p>
              <p class="portal-meta" data-latest-approved>Approved June 18, 2025</p>
              <div class="portal-cta-row">
                <button type="button" class="portal-cta" data-open-site>Open my website</button>
                <button type="button" class="client-btn-soft" data-revise-latest>Request changes</button>
              </div>
            </div>

            <section class="portal-version-list">
              <h3 class="portal-version-list-title">Approved versions</h3>
              <ul class="portal-version-items" data-versions></ul>
            </section>
          </div>

          <!-- Version tree ------------------------------------------------- -->
          <div class="portal-tab" data-panel="version-tree" hidden>
            <div class="portal-tab-header">
              <div>
                <p class="dash-eyebrow">Website</p>
                <h1>Version tree</h1>
                <p class="portal-tab-lead">
                  Every approved version, and which one it grew out of.
                </p>
              </div>
            </div>
            <div class="portal-panel portal-panel--flush">
              <ol class="vtree" data-vtree></ol>
            </div>
          </div>

          <!-- Free preview ------------------------------------------------- -->
          <div class="portal-tab mock-site-tab" data-panel="mock-site" hidden>
            <div class="portal-tab-header">
              <div>
                <p class="dash-eyebrow">Website</p>
                <h1>Free preview</h1>
                <p class="portal-tab-lead">A free sample website for your business. No payment needed.</p>
              </div>
              <button type="button" class="client-btn-soft" data-check="mock">Check again</button>
            </div>

            <div class="portal-panel">
              <span class="portal-status">Ready</span>
              <h2>Rosa's Bakery</h2>
              <p class="portal-copy">
                Your free preview is ready. Tap the button below to open it in a new tab.
              </p>
              <p class="portal-meta" data-mock-date>Finished March 4, 2025</p>
              <button type="button" class="portal-cta" data-open-mock>Open preview</button>
            </div>
          </div>

          <!-- Assets ------------------------------------------------------- -->
          <div class="portal-tab" data-panel="assets" hidden>
            <div class="portal-tab-header">
              <div>
                <p class="dash-eyebrow">Library</p>
                <h1>Assets</h1>
                <p class="portal-tab-lead">
                  Photos you upload here can be attached to image slots on your website.
                </p>
              </div>
              <button type="button" class="client-btn-soft" data-add-asset>Add images</button>
            </div>
            <div class="portal-panel portal-panel--flush">
              <div class="assets-empty" data-assets-empty>
                <p class="assets-empty__title">No photos yet</p>
                <p class="assets-empty__detail">
                  In the real portal you'd drag files in from your computer. Here, the button
                  above adds a few samples so you can see what the library looks like.
                </p>
              </div>
              <ul class="assets-grid" data-assets hidden></ul>
            </div>
          </div>
        </main>
      </div>
    </div>

    <!-- ── Change-request workspace (overlay) ──────────────────────────── -->
    <div class="client-revise-overlay" data-revise hidden>
      <div
        class="client-revise-shell"
        role="dialog"
        aria-modal="true"
        aria-labelledby="client-revise-title"
      >
        <section class="client-revise-preview">
          <header class="client-revise-preview-header">
            <div>
              <h2 id="client-revise-title">
                Rosa's Bakery
                <span class="client-revise-version-pill" data-revise-version>Version 3</span>
              </h2>
              <p class="client-revise-hint">
                Click something on the website to leave a note. Yellow outlines are menu links —
                click those to switch pages.
              </p>
            </div>
            <div class="client-revise-preview-actions">
              <button type="button" class="client-btn-soft" data-refresh>Refresh</button>
              <button type="button" class="client-btn-ghost" data-close aria-label="Close">✕</button>
            </div>
          </header>

          <div class="client-revise-preview-body">
            <iframe class="client-revise-frame" data-frame title="Rosa's Bakery revision preview"></iframe>
          </div>
        </section>

        <aside class="client-revise-sidebar">
          <div class="client-revise-sidebar-header">
            <h3>Request changes</h3>
            <p>
              Tell us what to change. You can write general notes, notes for this page, or click
              parts of the site.
            </p>
            <span class="client-revise-page-pill" data-page-pill>Home page</span>
          </div>

          <form class="client-revise-sidebar-body" data-revise-form>
            <label class="client-revise-field">
              <span>Changes for the whole website</span>
              <textarea
                class="client-revise-textarea"
                data-overall
                placeholder="Example: use more yellow, make everything bolder, more modern, more contrast."
                rows="4"></textarea>
            </label>

            <label class="client-revise-field">
              <span>Changes for this page only</span>
              <textarea
                class="client-revise-textarea"
                data-page-edits
                placeholder="Example: move the phone number higher, shorten the intro text."
                rows="3"></textarea>
            </label>

            <div data-notes-host>
              <div class="client-revise-empty" data-notes-empty>
                No items selected on this page yet. Click anything on the left to add a note.
              </div>
              <div class="client-revise-notes" data-notes hidden></div>
            </div>

            <div class="client-revise-preview-box" data-prompt-box hidden>
              <span>What we'll send</span>
              <pre data-prompt></pre>
            </div>

            <div class="client-revise-actions">
              <button type="submit" class="portal-cta client-revise-submit" data-send disabled>
                Send change request
              </button>
              <button type="button" class="client-btn-soft" data-cancel>Cancel</button>
            </div>
          </form>
        </aside>
      </div>
    </div>
  </div>

  <!-- Our narration, deliberately outside the portal chrome so it can't be
       mistaken for part of the product. -->
  <div class="sandbox__log" data-log hidden>
    <h3>What we'd receive</h3>
    <p>
      Everything you send in the demo lands here instead of in our inbox. This is
      the exact text the real portal would deliver to us.
    </p>
    <ol data-log-items></ol>
  </div>
</div>

<style is:global>
  /* ══════════════════════════════════════════════════════════════════════
     Portal styles.

     Ported from client/src/index.css on the `development` branch, trimmed to
     the classes this demo actually uses.

     The portal was redesigned onto gold-on-black, and its own token block now
     opens with a comment saying it mirrors this marketing site. So these are
     no longer a foreign palette being quarantined — they are the same four
     colours, aliased to the names the portal's classes use. The .sandbox scope
     stays because the portal's radii, type sizes and spacing are its own.

     If the real portal's design changes, this is the block to update.
     ══════════════════════════════════════════════════════════════════════ */

  .sandbox {
    /* Same values as client/src/index.css :root */
    --black: #0a0a0c;
    --gold: #f5c24b;
    --gold-soft: rgba(245, 194, 75, 0.12);
    --gold-line: rgba(245, 194, 75, 0.32);

    --bg: #0a0a0c;
    --bg-soft: #101015;
    --surface: #16161d;
    --ink: #ffffff;
    --ink-soft: #e6e7eb;
    --muted: #a9adb6;
    --line: rgba(230, 231, 235, 0.14);
    --line-strong: rgba(230, 231, 235, 0.24);
    --accent: #f5c24b;
    --accent-hover: #f8cb5e;
    --accent-ink: #0a0a0c;
    --accent-soft: rgba(245, 194, 75, 0.12);
    /* The portal's radii are tighter than ours — 6px, not 14px. */
    --p-radius: 6px;
    --p-font: var(--font-body);
    --p-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .sandbox * { box-sizing: border-box; }

  .sandbox__frame {
    position: relative;
    height: min(84vh, 860px);
    min-height: 560px;
    overflow: hidden;
    border: 1px solid var(--line-dark);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--bg);
    font-family: var(--p-font);
    color: var(--ink);
  }

  .sandbox__frame button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }

  /* Dashboard shell ------------------------------------------------------ */

  /* Shell — sidebar + topbar, mirroring client/src/layouts/Dashboard.jsx */

  .sandbox .client-dashboard { display: flex; height: 100%; min-height: 0; }

  .sandbox .client-sidebar {
    display: flex;
    flex-direction: column;
    width: 15.5rem;
    flex-shrink: 0;
    padding: 1.35rem 1rem 1.15rem;
    background: rgba(10, 10, 12, 0.92);
    border-right: 1px solid var(--line);
  }

  .sandbox .client-sidebar-brand {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.15rem 0.55rem 1.15rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1rem;
  }

  .sandbox .client-wordmark { display: inline-flex; align-items: center; gap: 0.55rem; min-width: 0; }
  .sandbox .client-wordmark__mark { width: 1.7rem; height: 1.7rem; flex-shrink: 0; }

  .sandbox .client-wordmark__text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
    color: var(--ink);
    white-space: nowrap;
  }

  .sandbox .client-tagline { font-size: 0.8rem; font-weight: 600; color: var(--muted); }

  .sandbox .client-nav { display: flex; flex-direction: column; gap: 1.1rem; }
  .sandbox .client-nav-group { display: flex; flex-direction: column; gap: 0.25rem; }

  .sandbox .client-nav-group-label {
    margin: 0 0 0.2rem;
    padding: 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sandbox .client-nav-tab {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.75rem;
    text-align: left;
    color: var(--ink-soft);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    border: 1px solid transparent;
    border-radius: 6px;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .sandbox .client-nav-tab__hint {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgba(169, 173, 182, 0.72);
  }

  .sandbox .client-nav-tab:hover {
    color: var(--ink);
    background: rgba(230, 231, 235, 0.06);
    border-color: rgba(230, 231, 235, 0.1);
  }

  .sandbox .client-nav-tab.active {
    color: var(--ink);
    background: rgba(230, 231, 235, 0.1);
    border-color: rgba(245, 194, 75, 0.28);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .sandbox .client-nav-tab.active .client-nav-tab__hint { color: rgba(245, 194, 75, 0.72); }

  .sandbox .client-sidebar-footer {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1rem;
    margin-top: auto;
    border-top: 1px solid var(--line);
  }

  .sandbox .client-user-chip--profile { display: flex; align-items: center; gap: 0.55rem; }

  .sandbox .client-user-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid var(--gold-line);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .sandbox .client-user-chip__text { display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
  .sandbox .client-user-chip__name { font-size: 0.92rem; font-weight: 700; color: var(--ink); }
  .sandbox .client-user-chip__label { font-size: 0.72rem; font-weight: 600; color: var(--muted); }

  .sandbox .client-content { flex: 1; min-width: 0; display: flex; flex-direction: column; }

  .sandbox .client-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.2rem;
    padding: 0.65rem 1.5rem;
    background: rgba(10, 10, 12, 0.88);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }

  .sandbox .client-topbar-left,
  .sandbox .client-topbar-right { display: flex; align-items: center; gap: 0.75rem; min-width: 0; }

  .sandbox .client-breadcrumbs__current {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .sandbox .client-topbar-user { font-size: 0.88rem; font-weight: 600; color: var(--muted); }

  /* The burger only exists at narrow widths; the sidebar is permanent above. */
  .sandbox .client-burger { display: none; }

  .sandbox .client-btn-ghost {
    padding: 0.5rem 0.75rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--muted);
    border-radius: 7px;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .sandbox .client-btn-ghost:hover { color: var(--ink); background: rgba(255, 255, 255, 0.06); }

  .sandbox .client-btn-soft {
    padding: 0.6rem 1rem;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ink);
    background: var(--bg-soft);
    border: 1px solid var(--line-strong);
    border-radius: var(--p-radius);
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .sandbox .client-btn-soft:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .sandbox .client-btn-soft:disabled { opacity: 0.5; cursor: not-allowed; }

  .sandbox .client-main { flex: 1; overflow-y: auto; padding: 1.75rem 1.75rem 3rem; }

