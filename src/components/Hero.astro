---
/**
 * The scroll-driven hero: a website assembles itself, then launches.
 *
 * How it works
 * ------------
 * The outer .hero is a few screens tall (see the .hero rule below). Inside
 * it, .hero__stage is position:sticky
 * so it parks at the top of the viewport for the whole scroll — that's the
 * "pin", done in CSS rather than with a scroll library, which keeps it
 * jank-free and means there is no layout shift if JS is slow.
 *
 * src/scripts/hero.js reads how far through .hero we are (0 → 1), draws the
 * scene on the canvas, and cross-fades the four copy beats below.
 *
 * Where the copy sits, and why
 * ----------------------------
 * Nothing in the scene is ever allowed behind or across the text:
 *
 *   open    centred   the scene scatters fragments into a ring *around* it
 *   build   bottom    the mockup assembles in the upper two-thirds
 *   launch  bottom    the mockup is flying up and out of the top
 *   close   centred   everything has left the frame; this lands on clean black
 *
 * If JS fails, is still loading, or the visitor prefers reduced motion, the
 * markup already renders a complete hero — headline, sub, both CTAs and a
 * CSS drawing of the assembled site — with nothing overlapping.
 */
import { url } from '../data/url.js';
---

<section class="hero" data-hero aria-label="Introduction">
  <div class="hero__stage">
    <!-- Star field. Painted before the canvas arrives, kept under reduced motion. -->
    <div class="hero__static" aria-hidden="true"></div>

    <canvas class="hero__canvas" data-hero-canvas></canvas>

    <!-- Beat 1 — the drift ----------------------------------------------- -->
    <div class="hero__beat hero__beat--center" data-beat="open">
      <div class="shell">
        <p class="hero__eyebrow">Websites for local business</p>
        <h1 class="hero__title">
          Websites that are<br /><span class="hero__title-gold">out of this world.</span>
        </h1>
        <p class="hero__sub">
          Custom sites for local businesses — built by students who go above and beyond.
        </p>
      </div>
    </div>

    <!-- Beat 2 — the assembly -------------------------------------------- -->
    <div class="hero__beat hero__beat--bottom" data-beat="build">
      <div class="shell">
        <p class="hero__line">We design it. We build it.</p>
        <p class="hero__caption">Every piece made for your business.</p>
      </div>
    </div>

    <!-- Beat 3 — the launch ---------------------------------------------- -->
    <div class="hero__beat hero__beat--bottom" data-beat="launch">
      <div class="shell">
        <p class="hero__line">Then we launch it.</p>
        <p class="hero__caption">Live on the web, in your name.</p>
      </div>
    </div>

    <!-- Beat 4 — the finale, on clean black ------------------------------ -->
    <div class="hero__beat hero__beat--center" data-beat="close">
      <div class="shell">
        <h2 class="hero__closing">Above and beyond.</h2>
        <div class="btn-row btn-row--center hero__ctas">
          <a class="btn btn--gold btn--lg" href={url('/contact')}>Request a free mockup</a>
          <a class="btn btn--ghost btn--lg" href={url('/work')}>See our work</a>
        </div>
      </div>
    </div>

    <!-- A CSS drawing of the assembled site. Only ever shown when the canvas
         isn't running: no JS, or reduced motion. Sits below the copy in flow,
         so it can't overlap it. -->
    <div class="hero__mock" aria-hidden="true">
      <span class="hero__mock-chrome"></span>
      <span class="hero__mock-nav"></span>
      <span class="hero__mock-img"></span>
      <span class="hero__mock-line hero__mock-line--a"></span>
      <span class="hero__mock-line hero__mock-line--b"></span>
      <span class="hero__mock-btn"></span>
    </div>

    <!-- Scroll hint ------------------------------------------------------ -->
    <div class="hero__hint" data-hero-hint aria-hidden="true">
      <span>Scroll</span>
      <span class="hero__hint-line"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* The scroll distance the sequence plays over. 100vh of this is the
       pinned stage itself, so the animation gets height - 100vh of travel.
       The beats in hero.js are positioned in absolute vh, so changing this
       only lengthens or shortens the quiet tail after the CTAs land — it
       does not retime the assembly or the launch. */
    height: 338vh;
    background: var(--black);
  }

  .hero__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh; /* avoids the mobile URL-bar jump */
    overflow: hidden;
    isolation: isolate;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
    opacity: 0;
    transition: opacity 700ms var(--ease);
  }

  .hero.is-live .hero__canvas { opacity: 1; }
  .hero.is-live .hero__static { opacity: 0; }

  /* Star field ----------------------------------------------------------- */

  .hero__static {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(1.6px 1.6px at 12% 18%, rgba(255, 255, 255, 0.85), transparent),
      radial-gradient(1.2px 1.2px at 27% 62%, rgba(230, 231, 235, 0.6), transparent),
      radial-gradient(1.8px 1.8px at 63% 12%, rgba(245, 194, 75, 0.65), transparent),
      radial-gradient(1.1px 1.1px at 78% 44%, rgba(255, 255, 255, 0.6), transparent),
      radial-gradient(1.4px 1.4px at 88% 74%, rgba(230, 231, 235, 0.5), transparent),
      radial-gradient(1px 1px at 42% 86%, rgba(255, 255, 255, 0.45), transparent),
      radial-gradient(1.5px 1.5px at 8% 74%, rgba(245, 194, 75, 0.4), transparent),
      radial-gradient(1.1px 1.1px at 53% 34%, rgba(255, 255, 255, 0.5), transparent),
      radial-gradient(1.3px 1.3px at 34% 8%, rgba(230, 231, 235, 0.55), transparent),
      radial-gradient(1px 1px at 70% 92%, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(ellipse 90% 80% at 50% 50%, transparent 30%, rgba(0, 0, 0, 0.7) 100%),
      var(--black);
    background-size: 760px 760px, 760px 760px, 760px 760px, 760px 760px, 760px 760px,
      760px 760px, 760px 760px, 760px 760px, 760px 760px, 760px 760px, 100% 100%, 100% 100%;
    transition: opacity 700ms var(--ease);
  }

  /* Copy beats ----------------------------------------------------------- */

  .hero__beat {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    text-align: center;
    pointer-events: none;
    opacity: 0;
  }

  .hero__beat--center { justify-content: center; }

  .hero__beat--bottom {
    justify-content: flex-end;
    padding-bottom: clamp(3rem, 9vh, 6.5rem);
  }

  /* The opening beat is the only one visible before JS takes over. */
  .hero__beat--center[data-beat='open'] { opacity: 1; }

  .hero__beat a { pointer-events: auto; }

  /* A soft scrim, on the beats that have scene elements near them. The
     closing beat deliberately has none: by then the frame is empty, and a
     scrim there would be covering nothing. */
  .hero__beat[data-beat='open']::before,
  .hero__beat[data-beat='build']::before,
  .hero__beat[data-beat='launch']::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      ellipse 66% 42% at 50% var(--scrim-y, 46%),
      rgba(10, 10, 12, 0.72) 0%,
      rgba(10, 10, 12, 0.4) 46%,
      transparent 76%
    );
    pointer-events: none;
  }

  .hero__beat--bottom::before { --scrim-y: 82%; }

  /* Without JS only the opening beat should show — the others would stack. */
  html.no-js .hero__beat:not([data-beat='open']),
  .hero:not(.is-live) .hero__beat:not([data-beat='open']) { display: none; }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: var(--s-4);
  }

  .hero__title {
    font-size: var(--t-display);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--white);
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.6);
  }

  .hero__title-gold { color: var(--gold); }

  .hero__sub {
    max-width: 34rem;
    margin: var(--s-4) auto 0;
    font-size: var(--t-lead);
    color: var(--silver-light);
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.7);
  }

  /* The two mid-scroll beats: smaller than the headline, so they read as
     narration over the action rather than competing with it. */
  .hero__line {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--white);
    text-shadow: 0 2px 32px rgba(0, 0, 0, 0.75);
  }

  .hero__caption {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    letter-spacing: 0.02em;
    color: var(--silver);
    text-shadow: 0 1px 20px rgba(0, 0, 0, 0.8);
  }

  .hero__closing {
    font-size: var(--t-display);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--white);
    margin-bottom: var(--s-5);
  }

  .hero__ctas { justify-content: center; }

  /* Static mockup -------------------------------------------------------- */

  .hero__mock { display: none; }

  /* Scroll hint ---------------------------------------------------------- */

  .hero__hint {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 3rem);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--silver);
    transition: opacity 400ms var(--ease);
  }

  .hero__hint-line {
    width: 1px;
    height: 42px;
    background: linear-gradient(180deg, var(--gold), transparent);
    transform-origin: top;
    animation: hint-drop 2s var(--ease) infinite;
  }

  @keyframes hint-drop {
    0%   { transform: scaleY(0); opacity: 0; }
    35%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* ── No JS / reduced motion ────────────────────────────────────────────
     One still screen: headline, sub, both CTAs, and a CSS drawing of the
     assembled site underneath. Everything is in flow, so nothing can end up
     behind the text. */

  @media (prefers-reduced-motion: reduce) {
    .hero { height: auto; min-height: 100vh; min-height: 100svh; }
    .hero__stage { position: relative; height: auto; min-height: 100vh; min-height: 100svh; }
    .hero__canvas { display: none; }
    .hero__hint { display: none; }
    .hero__static { opacity: 1 !important; }

    .hero__stage {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding-block: calc(72px + var(--s-7)) var(--s-7);
    }

    /* The mid-scroll narration has no animation to narrate. */
    .hero__beat[data-beat='build'],
    .hero__beat[data-beat='launch'] { display: none !important; }

    /* position:relative, not static — z-index only applies to positioned
       elements, and .hero__static is absolutely positioned, so without this
       the star field paints straight over the headline. */
    .hero__beat {
      position: relative;
      z-index: 2;
      inset: auto;
      display: flex !important;
      opacity: 1 !important;
      flex: 0 0 auto;
      width: 100%;
      padding-bottom: 0;
    }

    .hero__beat[data-beat='close'] { margin-top: var(--s-5); }
    .hero__beat[data-beat='close'] .hero__closing { display: none; }

    /* One scrim is plenty when both beats are stacked in flow. */
    .hero__beat[data-beat='close']::before { display: none; }

    /* The mockup, drawn in CSS, beneath the CTAs. */
    .hero__mock {
      position: relative;
      z-index: 2;
      display: block;
      width: min(90%, 30rem);
      aspect-ratio: 16 / 10;
      margin-top: var(--s-7);
      border: 1px solid rgba(169, 173, 182, 0.5);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.022);
    }

    .hero__mock span { position: absolute; display: block; }

    .hero__mock-chrome {
      inset: 0 0 auto 0;
      height: 10%;
      background: rgba(169, 173, 182, 0.08);
      border-bottom: 1px solid rgba(169, 173, 182, 0.25);
      border-radius: 11px 11px 0 0;
    }

    .hero__mock-nav {
      top: 16%;
      left: 4%;
      right: 4%;
      height: 8%;
      border: 1px solid rgba(245, 194, 75, 0.45);
      background: rgba(245, 194, 75, 0.1);
      border-radius: 5px;
    }

    .hero__mock-img {
      top: 30%;
      left: 4%;
      right: 4%;
      height: 30%;
      border: 1px solid rgba(169, 173, 182, 0.38);
      background: rgba(255, 255, 255, 0.03);
      border-radius: 6px;
    }

    .hero__mock-line {
      left: 4%;
      height: 4.5%;
      background: rgba(255, 255, 255, 0.8);
      border-radius: 3px;
    }

    .hero__mock-line--a { top: 66%; width: 52%; }
    .hero__mock-line--b { top: 74%; width: 36%; }

    .hero__mock-btn {
      top: 84%;
      left: 4%;
      width: 22%;
      height: 7%;
      background: var(--gold);
      border-radius: 99px;
    }
  }
</style>

<script>
  import '../scripts/hero.js';
</script>
