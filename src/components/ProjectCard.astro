---
/**
 * One card in the Our Work grid.
 *
 * To add a project: put its HTML in public/, save a screenshot to
 * public/shots/<slug>.webp, then add an entry to PROJECTS in src/data/site.js.
 * Nothing here needs editing.
 */
import { url } from '../data/url.js';

interface Props {
  project: {
    slug: string;
    name: string;
    type: string;
    href: string;
    shot: string;
    blurb: string;
  };
  reveal?: boolean;
  /**
   * Heading level for the business name. On /work the cards sit directly under
   * the page's h1, so they're h2; on the home page they sit under a section h2,
   * so they're h3. Getting this wrong skips a level and fails accessibility
   * checks, hence the prop rather than a hardcoded tag.
   */
  level?: 2 | 3;
}

const { project, reveal = false, level = 3 } = Astro.props;
const Heading = `h${level}`;
---

<article class="project" data-reveal={reveal ? '' : undefined}>
  <a class="project__shot" href={url(project.href)} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
    <img
      src={url(project.shot)}
      alt=""
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
  </a>

  <div class="project__body">
    <span class="badge">{project.type}</span>
    <Heading>{project.name}</Heading>
    <p>{project.blurb}</p>

    <a
      class="link-arrow project__link"
      href={url(project.href)}
      target="_blank"
      rel="noopener noreferrer"
    >
      View live site
      <span class="sr-only">— {project.name} (opens in a new tab)</span>
    </a>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .project:hover,
  .project:focus-within {
    transform: translateY(-4px);
    border-color: var(--gold-line);
    box-shadow: var(--shadow-light);
  }

  .project__shot {
    display: block;
    overflow: hidden;
    background: var(--silver-light);
    border-bottom: 1px solid var(--line-light);
    aspect-ratio: 4 / 3;
  }

  .project__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 500ms var(--ease);
  }

  .project:hover .project__shot img { transform: scale(1.035); }

  .project__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
    padding: var(--s-4);
    flex: 1;
  }

  .project__body :is(h2, h3) { margin-top: 0.2rem; font-size: var(--t-h3); }

  .project__body p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    flex: 1;
  }

  .project__link { margin-top: var(--s-2); }

  /* On dark sections the card flips to the panel colours. */
  :global(.section--dark) .project {
    background: var(--panel);
    border-color: var(--line-dark);
  }

  :global(.section--dark) .project__shot { border-bottom-color: var(--line-dark); }
  :global(.section--dark) .project__body :is(h2, h3) { color: var(--white); }
  :global(.section--dark) .project__body p { color: var(--silver); }

  @media (prefers-reduced-motion: reduce) {
    .project:hover { transform: none; }
    .project:hover .project__shot img { transform: none; }
  }
</style>
