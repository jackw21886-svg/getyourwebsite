---
/**
 * The shell every page uses: <head>, nav, <main>, footer.
 *
 * Pass a title and description on every page — they're the SEO basics and
 * there is no sensible default for them.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { url } from '../data/url.js';
import { HEADING_FONT } from '../data/site.js';

/**
 * The self-hosted heading faces. See HEADING_FONT in src/data/site.js — that
 * one line is the switch; nothing here needs editing to change fonts.
 *
 * Each is a variable font, so one file covers every weight the headings use.
 */
const HEADING_FACES = {
  // `track` overrides --h-track. A wider face has to be set tighter to hold the
  // same line counts: Clash Display at the stock -0.035em pushed the pricing
  // and Why Us H1s from two lines to three, and -0.045em brings both back at
  // full size, so nothing had to shrink. Measured with tools/wraps.mjs.
  clash: {
    family: 'Clash Display',
    file: 'ClashDisplay-Variable.woff2',
    track: '-0.045em',
  },
  cabinet: { family: 'Cabinet Grotesk', file: 'CabinetGrotesk-Variable.woff2' },
  sora: { family: 'Sora', file: 'Sora-Variable.woff2' },
};

const headingFace = HEADING_FACES[HEADING_FONT];

interface Props {
  title: string;
  description: string;
  /** true on the home page only: nav floats over the hero */
  transparentNav?: boolean;
  /** drop the default page padding (the home hero handles its own) */
  bleed?: boolean;
}

const { title, description, transparentNav = false, bleed = false } = Astro.props;

const fullTitle = title === 'GetYourWebsite'
  ? 'GetYourWebsite — websites that are out of this world'
  : `${title} · GetYourWebsite`;

// Astro.site comes from SITE_URL in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');
const ogImage = new URL(url('/og.png'), Astro.site ?? 'https://example.com');

// Outfit (headings) / Work Sans (body) / JetBrains Mono (labels and figures).
const FONT_CSS =
  'https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Work+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap';
---

<!doctype html>
<!-- data-base lets client-side scripts (the hero's texture loader) build URLs
     that work whether the site is served from / or from /getyourwebsite/. -->
<html lang="en" class="no-js" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <!-- Social card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GetYourWebsite" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0A0A0C" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />

    <!-- Fonts: Outfit (headings) / Work Sans (body) / JetBrains Mono (labels).
         Preconnect first so the font request starts as early as possible. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load the font CSS without blocking the first paint: fetch it as a
         print stylesheet (which browsers don't wait for), then switch it to
         `all` once it has arrived. The <noscript> copy covers the rest. -->
    <link
      rel="stylesheet"
      href={FONT_CSS}
      media="print"
      onload="this.media='all'; this.onload=null;"
    />
    <noscript><link rel="stylesheet" href={FONT_CSS} /></noscript>

    <!-- A self-hosted heading face, if one is selected. Preloaded because it
         is on the critical path for the largest text on the page and comes
         from our own origin, so there's no DNS or TLS handshake to wait on —
         and the @font-face in global.css carries font-display: swap, so the
         page still paints in the fallback if it's slow. -->
    {
      headingFace && (
        <>
          <link
            rel="preload"
            as="font"
            type="font/woff2"
            crossorigin
            href={url(`/fonts/${headingFace.file}`)}
          />
          {/* html:root, not :root. Astro's stylesheet link lands after this
              inline block, so at equal specificity global.css would win the
              cascade and the override would silently do nothing — the page
              ships the preload and the declaration and still renders Outfit.
              The extra element selector outranks it wherever it sits. */}
          <style
            set:html={
              `html:root{--font-display:'${headingFace.family}','Outfit',system-ui,-apple-system,sans-serif` +
              (headingFace.track ? `;--h-track:${headingFace.track}` : '') +
              `}`
            }
          />
        </>
      )
    }

    <!-- Swap .no-js for .js before first paint so [data-reveal] elements are
         hidden only when JS can actually reveal them again. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <Nav transparent={transparentNav} />

    <main id="main" class:list={[{ 'main--bleed': bleed }]}>
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/reveal.js';
      import '../scripts/buttons.js';
      import '../scripts/ambient.js';
    </script>
  </body>
</html>

<style is:global>
  /* Pages that aren't the home page start below a solid nav, so they need no
     extra offset. The home page's nav is fixed, hence .main--bleed. */
  .main--bleed { padding-top: 0; }
</style>
